{
  "name": "langkahku",
  "private": true,
  "type": "module",
  "scripts": {
    "api:content": "node scripts/build-api-content.mjs",
    "api:test": "npm run api:content && node --test \"supabase/functions/api/**/*.test.ts\"",
    "api:typecheck": "npm run api:content && tsc -p supabase/functions/api/tsconfig.json",
    "api:dev": "npm run api:content && node --env-file-if-exists=.env supabase/functions/api/dev-server.ts",
    "api:deploy": "npm run api:content && supabase functions deploy api --no-verify-jwt",
    "db:push": "supabase db push --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "@hono/node-server": "^2.1.8",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.18",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "^26.6.6",
    "supabase": "^3.1.0",
    "typescript": "^5.9.3"
  }
}
