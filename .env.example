# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.

# ---------- Backend (apps/api) ----------
APP_ENV=development                      # development | staging | production
# Backend Supabase (`npm run api:dev`): connection string Supabase (Project Settings → Database → Session pooler),
# simpan di .env.local (tidak di-commit). Di Supabase, fungsi memakai SUPABASE_DB_URL otomatis.
# Backend Python lokal: kosongkan untuk SQLite.
DATABASE_URL=
SEED_DEMO=true                           # akun demo siswa/siswa123 & guru/guru123; false untuk siswa sungguhan
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
BCRYPT_ROUNDS=12
RATE_LIMIT_LOGIN_PER_MINUTE=5
CONTENT_DIR=../../content

# ---------- Pemodel soal cerita (Claude API) — hanya di backend ----------
ANTHROPIC_API_KEY=                       # isi di server; JANGAN taruh di frontend/APK
MODELER_MODEL=claude-opus-5-5
MODELER_EFFORT=medium                    # low | medium | high — ubah hanya setelah menjalankan set evaluasi
MODELER_TIMEOUT_SECONDS=30
MODELER_DEFAULT_DAILY_QUOTA=10           # per siswa
MODELER_MONTHLY_BUDGET_USD=50            # fitur dijeda otomatis bila terlampaui

# ---------- Frontend (apps/web) — prefiks VITE_ terekspos ke browser ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=LangkahKu
