[
  {
    "id": "PRE-1",
    "kind": "prerequisite",
    "order": 1,
    "title": "Bilangan Bulat",
    "subtitle": "Positif, negatif, dan tandanya",
    "icon": "calc",
    "objective": "Kamu bisa menghitung bilangan negatif tanpa salah tanda.",
    "screens": [
      {
        "concept": "garis-bilangan",
        "instruction": "Bilangan negatif ada di kiri nol. Makin ke kiri, makin kecil.",
        "blocks": [
          { "type": "numberline", "from": -5, "to": 5, "marks": [-3, 2] },
          { "type": "callout", "text": "−3 lebih kecil dari 2." }
        ]
      },
      {
        "concept": "tambah-kurang-negatif",
        "instruction": "Mengurangi sama dengan menambah lawannya.",
        "blocks": [
          { "type": "math", "text": "5 − 8 = 5 + (−8) = −3" },
          { "type": "math", "text": "−4 − (−6) = −4 + 6 = 2" }
        ]
      },
      {
        "concept": "kali-tanda",
        "instruction": "Tanda sama hasilnya positif. Tanda beda hasilnya negatif.",
        "blocks": [
          { "type": "table", "rows": [["×", "+", "−"], ["+", "+", "−"], ["−", "−", "+"]] },
          { "type": "math", "text": "(−4) × (−3) = 12" }
        ]
      },
      {
        "concept": "kuadrat-negatif",
        "instruction": "Kuadrat artinya dikali dirinya sendiri. Perhatikan tanda kurungnya.",
        "blocks": [
          { "type": "math", "text": "(−3)² = (−3) × (−3) = 9" },
          { "type": "callout", "text": "−3² = −(3 × 3) = −9. Kurung membuat beda!" }
        ]
      }
    ],
    "problems": [
      {
        "id": "PRE-1-p1",
        "title": "Latihan tanda",
        "mode": "independent",
        "steps": [
          { "instruction": "Hitung −7 + 3.", "check": "value", "expected": "-4", "display": "−4",
            "hints": ["Mulai dari −7, bergerak 3 ke kanan.", "Selisih 7 dan 3 adalah 4. Tandanya ikut yang lebih besar.", "−7 + 3 = −4"] },
          { "instruction": "Hitung (−4) × (−3).", "check": "value", "expected": "12", "display": "12",
            "hints": ["Lihat tabel tanda perkalian.", "Negatif kali negatif hasilnya positif.", "(−4) × (−3) = 12"] },
          { "instruction": "Hitung 2 − 9.", "check": "value", "expected": "-7", "display": "−7",
            "hints": ["Mengurangi 9 sama dengan menambah −9.", "2 + (−9). Selisihnya 7, tandanya negatif.", "2 − 9 = −7"] }
        ]
      }
    ]
  },
  {
    "id": "PRE-2",
    "kind": "prerequisite",
    "order": 2,
    "title": "Persamaan Linear Satu Variabel",
    "subtitle": "Menyelesaikan ax + b = c",
    "icon": "balance",
    "objective": "Kamu bisa mencari nilai x dan memindahkan suku dengan benar.",
    "recall": [{ "label": "Bilangan bulat", "module_id": "PRE-1" }],
    "screens": [
      {
        "concept": "timbangan",
        "instruction": "Persamaan seperti timbangan seimbang. Ruas kiri sama berat dengan ruas kanan.",
        "blocks": [
          { "type": "math", "text": "3x + 5 = 20" },
          { "type": "callout", "text": "Apa pun yang kamu lakukan di kiri, lakukan juga di kanan." }
        ]
      },
      {
        "concept": "pindah-suku",
        "instruction": "Memindahkan suku ke ruas lain mengubah tandanya.",
        "blocks": [
          { "type": "math", "text": "3x + 5 = 20" },
          { "type": "arrow", "label": "+5 pindah jadi −5" },
          { "type": "math", "text": "3x = 20 − 5 = 15" }
        ]
      },
      {
        "concept": "bagi-koefisien",
        "instruction": "Bagi kedua ruas dengan angka di depan x.",
        "blocks": [
          { "type": "math", "text": "3x = 15" },
          { "type": "arrow", "label": "bagi 3" },
          { "type": "math", "text": "x = 5" }
        ]
      },
      {
        "concept": "y-sendirian",
        "instruction": "Cara yang sama dipakai untuk membuat y sendirian.",
        "blocks": [
          { "type": "math", "text": "2x + y = 9" },
          { "type": "arrow", "label": "2x pindah jadi −2x" },
          { "type": "math", "text": "y = 9 − 2x" }
        ]
      }
    ],
    "problems": [
      {
        "id": "PRE-2-p1",
        "title": "Menyelesaikan 3x + 5 = 20",
        "mode": "independent",
        "steps": [
          { "instruction": "Pindahkan 5 ke ruas kanan.", "check": "equation_equivalent", "expected": "3*x = 15", "display": "3x = 15",
            "hints": ["Tujuannya: hanya suku x di ruas kiri.", "+5 pindah ke kanan menjadi −5.", "3x = 20 − 5 = 15"] },
          { "instruction": "Tentukan nilai x.", "check": "value", "expected": "5", "variable": "x", "display": "x = 5",
            "hints": ["Bagi kedua ruas dengan 3.", "x = 15 : 3", "x = 5"] },
          { "instruction": "Ubah 2x + y = 9 menjadi y = ...", "check": "equation_equivalent", "expected": "y = 9 - 2*x", "display": "y = 9 − 2x",
            "hints": ["Tujuannya: y sendirian di ruas kiri.", "Pindahkan 2x ke kanan. Tandanya berubah.", "y = 9 − 2x"] }
        ]
      }
    ]
  },
