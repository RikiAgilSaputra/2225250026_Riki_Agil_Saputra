    "screens": [
      {
        "concept": "mesin-fungsi",
        "instruction": "Fungsi seperti mesin. Masukkan x, keluar y.",
        "blocks": [
          { "type": "math", "text": "y = 2x − 1" },
          { "type": "math", "text": "x = 3  →  y = 2(3) − 1 = 5" }
        ]
      },
      {
        "concept": "tabel-xy",
        "instruction": "Coba beberapa nilai x, catat y-nya di tabel.",
        "blocks": [{ "type": "table", "rows": [["x", "0", "1", "2", "3"], ["y", "−1", "1", "3", "5"]] }]
      },
      {
        "concept": "tabel-ke-garis",
        "instruction": "Setiap pasangan (x, y) adalah titik. Hubungkan titiknya, jadilah garis.",
        "blocks": [{ "type": "graph", "lines": ["2*x - y = 1"], "points": [{ "x": 0, "y": -1 }, { "x": 1, "y": 1 }, { "x": 2, "y": 3 }, { "x": 3, "y": 5 }] }]
      }
    ],
    "problems": [
      {
        "id": "PRE-4-p1",
        "title": "Mencari y",
        "mode": "independent",
        "steps": [
          { "instruction": "Jika y = 2x − 1 dan x = 4, berapa y?", "check": "value", "expected": "7", "variable": "y", "display": "y = 7",
            "hints": ["Ganti x dengan 4.", "y = 2(4) − 1", "y = 8 − 1 = 7"] },
          { "instruction": "Jika y = 5 − x dan x = −2, berapa y?", "check": "value", "expected": "7", "variable": "y", "display": "y = 7",
            "hints": ["Ganti x dengan −2. Pakai kurung.", "y = 5 − (−2)", "y = 5 + 2 = 7"] }
        ]
      }
    ]
  }
