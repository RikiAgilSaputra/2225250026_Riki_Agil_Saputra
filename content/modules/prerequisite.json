  {
    "id": "PRE-4",
    "kind": "prerequisite",
    "order": 4,
    "title": "Fungsi y = f(x)",
    "subtitle": "Dari x ke y, dari tabel ke garis",
    "icon": "func",
    "objective": "Kamu bisa mencari nilai y jika x diketahui, lalu menggambarnya.",
