# LangkahKu — satu-satunya file pengaturan lingkungan. BERISI KUNCI ASLI dan sengaja di-commit agar bisa dinilai dosen.
# Daftar semua variabel: docs/DEPLOYMENT.md → "Variabel lingkungan".
# Baris "# NAMA=nilai" menunjukkan nilai bawaan — hapus "#" untuk mengubahnya.
# Produksi (Supabase) TIDAK membaca file ini: atur lewat `npx supabase secrets set NAMA=nilai`.

# ---------- Google AI Studio (Gemini) — satu-satunya penyedia AI ----------
# Ganti teks di kanan "=" dengan API key dari https://aistudio.google.com/apikey
# (format "AQ.…" maupun "AIza…" diterima). Tanpa spasi dan tanpa tanda kutip.
GEMINI_API_KEY=AQ.Ab8RN6J3U68aZej_yOkM6BOa0jRcrzEL06CVm2voGqJh5ox5iw
# MODELER_MODEL=gemini-3.5-flash-lite
# MODELER_FALLBACK_MODEL=gemini-3.8-flash # dipakai bila model utama sibuk; kosongkan untuk mematikan
# MODELER_EFFORT=medium                  # low | medium | high — ubah hanya setelah menjalankan set evaluasi
# MODELER_TIMEOUT_SECONDS=20             # di bawah batas proxy Netlify 26 detik
# MODELER_DEFAULT_DAILY_QUOTA=10         # per siswa
# MODELER_MONTHLY_BUDGET_USD=10          # fitur dijeda otomatis bila terlampaui
# MODELER_PRICE_IN_PER_M=1.5             # USD per 1 juta token, untuk batas anggaran
# MODELER_PRICE_OUT_PER_M=7.5

# ---------- Backend ----------
APP_ENV=development
# Kosong: backend Python memakai SQLite lokal. Untuk `npm run api:dev` (backend Supabase) isi dengan connection
# string Supabase: Dashboard → Project Settings → Database → Session pooler. Hati-hati: itu database produksi.
DATABASE_URL=
# JWT_SECRET=                            # wajib di produksi (string acak ≥ 32 karakter); lokal memakai nilai dev
# JWT_ACCESS_TTL_MINUTES=720
# CORS_ORIGINS=http://localhost:5173
# SEED_DEMO=true                         # akun demo siswa/siswa123 & guru/guru123; false untuk siswa sungguhan
